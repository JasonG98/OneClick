<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.files.user-selected.read-only</key><true/>
    <!--
      Finder hands the extension the user's selection without granting sandbox
      read access to it, so LaunchServices refuses to hand those items to any
      application ("could not be launched because a miscellaneous error
      occurred"). That is Apple issue rdar://42874694, still open. Without the
      exception below the extension can only stat a selection, never open it,
      which forces every open back through the container app.

      Read-only is the minimum that makes the hand-off work. The container app
      is not sandboxed either, so this does not widen the product's existing
      access; it is granted to the extension only, never to the app.
    -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-only</key><array><string>/</string></array>
    <!-- Shared settings and bounded error reports; relative to the real home,
         not the extension container. A directory exception needs a final /. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array><string>/Library/Application Support/OneClick/</string></array>
</dict></plist>
